
module kashi_app_generated_policy 1.0;

require {
	type user_devpts_t;
	type httpd_t;
	type httpd_sys_content_t;
	type chkpwd_t;
	class chr_file { read write };
	class file execute;
}

#============= chkpwd_t ==============
allow chkpwd_t user_devpts_t:chr_file { read write };

#============= httpd_t ==============

#!!!! This avc can be allowed using the boolean 'httpd_unified'
allow httpd_t httpd_sys_content_t:file execute;
