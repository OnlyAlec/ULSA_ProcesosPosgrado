{
    "require": {
        "phpoffice/phpspreadsheet": "^4.1",
        "vlucas/phpdotenv": "^5.6",
        "fpdf/fpdf": "^1.86",
        "getbrevo/brevo-php": "1.x.x",
        "spatie/mjml-php": "^1.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.73"
    },
    "scripts": {
        "format:prettier": "npx prettier --write . --config .prettierrc --ignore-path .prettierignore",
        "format:phpcsfixer": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.dist.php",
        "format": [
            "@format:prettier",
            "@format:phpcsfixer"
        ]
    }
}
